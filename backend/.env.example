# Serveur
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Base de données
DATABASE_URL="postgresql://sassfr:sassfr@localhost:5433/sassfr?schema=public"

# JWT
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# JWT dédié à la console plateforme (super-admin), distinct des secrets cabinet ci-dessus
PLATFORM_JWT_SECRET=change_me_platform_secret
PLATFORM_JWT_EXPIRES_IN=2h

# SMTP (relances, invitations) — Brevo (ex-Sendinblue) : palier gratuit 300 emails/jour, suffisant pour démarrer.
# 1. Créer un compte sur https://www.brevo.com (gratuit)
# 2. Paramètres > SMTP & API > SMTP : récupérer le login et la clé SMTP (pas le mot de passe du compte)
# 3. SMTP_FROM doit être un expéditeur validé dans Brevo (Paramètres > Expéditeurs)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=change_me_brevo_login
SMTP_PASSWORD=change_me_brevo_smtp_key
SMTP_FROM="Cabinet <no-reply@example.eu>"

# Stockage S3-compatible (OVHcloud / Scaleway Object Storage - UE)
S3_ENDPOINT=https://s3.gra.io.cloud.ovh.net
S3_REGION=gra
S3_BUCKET=sassfr-documents
S3_ACCESS_KEY_ID=change_me
S3_SECRET_ACCESS_KEY=change_me

# Relances automatiques
RELANCE_DELAI_JOURS=5
RELANCE_CRON_EXPRESSION="0 8 * * *"

# RGPD (droit à l'effacement / conservation limitée des documents clients)
RGPD_RETENTION_JOURS=1095
RGPD_CRON_EXPRESSION="0 3 * * *"

# Facturation (plan Starter : prix par dossier passé au statut "complet")
FACTURATION_PRIX_DOSSIER_STARTER=4

# OCR/IA (Mistral, option souveraine UE) — laisser vide pour utiliser le provider factice (StubOcrProvider)
MISTRAL_API_KEY=
MISTRAL_OCR_MODEL=mistral-ocr-latest
MISTRAL_EXTRACTION_MODEL=mistral-small-latest

# SMS (OVHcloud, UE) — laisser vide pour utiliser le provider factice (StubSmsProvider, log console)
OVH_API_ENDPOINT=https://eu.api.ovh.com/1.0
OVH_APP_KEY=
OVH_APP_SECRET=
OVH_CONSUMER_KEY=
OVH_SMS_SERVICE_NAME=
OVH_SMS_SENDER=

# Signature électronique (Yousign, UE) — laisser vide pour utiliser le provider factice (StubSignatureProvider)
YOUSIGN_API_KEY=
YOUSIGN_API_URL=https://api.yousign.app/v3

# Monitoring erreurs (Sentry, palier gratuit) — laisser vide pour désactiver (logs console uniquement)
# Compte gratuit sur https://sentry.io, DSN dans Settings > Projects > <projet> > Client Keys (DSN)
SENTRY_DSN=

# Paiement (Stripe, mode test gratuit) — laisser vide pour utiliser le provider factice (StubPaiementProvider)
# 1. Compte gratuit sur https://dashboard.stripe.com/register
# 2. Clé secrète (mode test) : Développeurs > Clés API > Clé secrète (sk_test_...)
# 3. Créer un produit + prix récurrent par plan (Starter/Cabinet/Premium) : Produits > Ajouter un produit,
#    copier l'id du prix (price_...) de chaque plan ci-dessous
# 4. Webhook (Développeurs > Webhooks > Ajouter un endpoint) : URL = <FRONTEND ou API publique>/facturation/webhook,
#    événements à écouter : checkout.session.completed, invoice.payment_failed, customer.subscription.deleted
#    → copier le "Signing secret" (whsec_...) dans STRIPE_WEBHOOK_SECRET
# En local, utiliser la Stripe CLI (`stripe listen --forward-to localhost:4000/facturation/webhook`) pour tester.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_CABINET=
STRIPE_PRICE_PREMIUM=
